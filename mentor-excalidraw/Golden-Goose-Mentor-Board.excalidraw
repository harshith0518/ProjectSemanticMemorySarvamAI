      "seed": 1063655132,
      "version": 1,
      "versionNonce": 459224154,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788652800000,
      "link": null,
      "locked": false,
      "text": "Problem: partial writes or retries duplicate\nstate.\nApproach: short transactions, stable operation\nkeys, expected revisions and fenced worker\nattempts.\nTest: stale worker cannot replace a newer\ncorrection.",
      "originalText": "Problem: partial writes or retries duplicate\nstate.\nApproach: short transactions, stable operation\nkeys, expected revisions and fenced worker\nattempts.\nTest: stale worker cannot replace a newer\ncorrection.",
