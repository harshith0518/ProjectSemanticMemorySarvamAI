    {
      "id": "el-0181",
      "type": "text",
      "x": 2352,
      "y": 1817.5,
      "width": 452,
      "height": 183.75,
      "angle": 0,
      "strokeColor": "#203c36",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "g-179"
      ],
