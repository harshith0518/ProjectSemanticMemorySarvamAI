    {
      "id": "el-0184",
      "type": "text",
      "x": 2870,
      "y": 1817.5,
      "width": 452,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#203c36",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "g-182"
      ],
