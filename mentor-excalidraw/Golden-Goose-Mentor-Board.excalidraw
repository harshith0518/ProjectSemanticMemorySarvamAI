      "versionNonce": 605501656,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788652800000,
      "link": null,
      "locked": false,
      "text": "LIVE ORDER: private input + held job → retrieve → model proposal → commit controls → release only allowed learning → continue → check freshness +\nsave answer → deliver / current-eligible replay.",
      "originalText": "LIVE ORDER: private input + held job → retrieve → model proposal → commit controls → release only allowed learning → continue → check freshness +\nsave answer → deliver / current-eligible replay.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "el-0187",
      "type": "text",
      "x": 1816,
      "y": 2226,
      "width": 1528,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#203c36",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-03",
      "roundness": null,
      "seed": 120623748,
      "version": 1,
      "versionNonce": 297428636,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788652800000,
      "link": null,
      "locked": false,
      "text": "Freshness token = the knowledge versions used for an answer. Any meaning-changing write requires refresh. A narrow service-only exception covers\npublishing unchanged, already-seen input; it is not a general bypass.",
      "originalText": "Freshness token = the knowledge versions used for an answer. Any meaning-changing write requires refresh. A narrow service-only exception covers\npublishing unchanged, already-seen input; it is not a general bypass.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "el-0188",
      "type": "text",
      "x": 1816,
      "y": 2303,
      "width": 1528,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#203c36",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.6,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-03",
      "roundness": null,
      "seed": 240549645,
      "version": 1,
      "versionNonce": 950424071,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788652800000,
      "link": null,
      "locked": false,
      "text": "Operation key = one logical request. Same key + same payload reuses its receipt; changed payload conflicts. Fencing token = attempt identity that blocks a\nreplaced worker. Model/tool calls stay outside database transactions.",
      "originalText": "Operation key = one logical request. Same key + same payload reuses its receipt; changed payload conflicts. Fencing token = attempt identity that blocks a\nreplaced worker. Model/tool calls stay outside database transactions.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
