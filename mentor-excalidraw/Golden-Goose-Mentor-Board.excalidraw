      "version": 1,
      "versionNonce": 641957204,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788652800000,
      "link": null,
      "locked": false,
      "text": "Problem: correction races an answer, or a\ntimeout hides an executed effect.\nApproach: recheck publication; code verifies\nauthority and receipts; reconcile unknown\neffects.\nTest: no false “saved” or duplicate blind retry.",
      "originalText": "Problem: correction races an answer, or a\ntimeout hides an executed effect.\nApproach: recheck publication; code verifies\nauthority and receipts; reconcile unknown\neffects.\nTest: no false “saved” or duplicate blind retry.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
