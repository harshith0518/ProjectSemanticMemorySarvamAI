# Local development only. Set these before first startup; never commit .env.
# Changing these later does not rotate passwords stored in an existing volume.
KIVI_POSTGRES_PASSWORD=local-only-admin-change-me
KIVI_MIGRATION_PASSWORD=local-only-migration-change-me
KIVI_APP_PASSWORD=local-only-runtime-change-me
KIVI_API_PORT=8000
# Enable only after the explicit synthetic-only NVIDIA trial decision.
# Combined lifetime limits: 1100 requests, 10,000,000 accounted tokens, $0 paid.
# Exact checked-in synthetic sources/questions only unless reviewer opt-in below is enabled.
KIVI_S07_SYNTHETIC_TRIAL_APPROVED=false
NEMOTRON_30B_API_KEY=
KIMI_K3_API_KEY=
KIVI_RESPONSE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
KIVI_MAX_REQUESTS=1100
KIVI_MAX_TOTAL_TOKENS=10000000
# Separate operator consent for an unfamiliar Normal-mode corpus and new questions.
# NVIDIA may retain/use submitted content under its data terms. Do not use sensitive data
# without the necessary permission. Private remains blocked. Never commit the filled file.
KIVI_REVIEWER_INFERENCE_APPROVED=false
# To opt in, set the preceding flag to true AND the following exact acknowledgement:
# KIVI_REVIEWER_DATA_POLICY_ACK=I_ACCEPT_NVIDIA_DATA_TERMS
KIVI_REVIEWER_DATA_POLICY_ACK=
NVIDIA_API_KEY=
# Explicit alternative public-synthetic routes; not personal/reviewer inference.
# Google free inputs/outputs may be used for improvement and human review.
# No paid fallback. Catalog access does not establish available daily quota.
KIVI_INFERENCE_PROVIDER=nvidia
KIVI_FREE_SYNTHETIC_TRIAL_APPROVED=false
KIVI_FREE_DATA_POLICY_ACK=
# After informed synthetic-only approval:
# KIVI_FREE_DATA_POLICY_ACK=I_ACCEPT_FREE_SYNTHETIC_DATA_TERMS
GOOGLE_API_KEY_FREE_TIER=
OPEN_ROUTER_API_KEY=

# Manual NVIDIA reasoning backup; never used automatically.
POOLSIDE_LAGUNA_XS_2P1=
# Optional embedding diagnostic key. Dense retrieval/tool execution are not enabled.
NEMOTRON_1B_EMBED=
# Optional free-route role models. Blank uses that provider's supported default.
# For Google explicitly choose gemini-3.5-flash-lite for both roles.
KIVI_FREE_EXTRACTOR_MODEL=
KIVI_FREE_RESPONDER_MODEL=
